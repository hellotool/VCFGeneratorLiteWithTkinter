{
  "explorer.fileNesting.patterns": {
    "pyproject.toml": "uv.lock, .python-version, .pdm-python, .editorconfig, *.toml, *.json, *.yml",
    "README.md": "README_*.md",
    "*": "${basename}.*.${extname}"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "[markdown]": {
    "editor.defaultFormatter": "rvben.rumdl",
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "always",
    "source.fixAll.rumdl": "always",
    "source.fixAll.pylance": "always",
  },
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "files.eol": "\n",
  "files.associations": {
    "*.spec": "python"
  },
  "rumdl.enable": true,
  "rumdl.configPath": "rumdl.toml",
}
