#define AppExeName "vcf-generator-lite.exe"
; Other constant definitions can be found in scripts\build_app\innosetup.py.

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{2CA151A5-049F-4AD9-92B1-5F0A244F52A4}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={cm:AppName} {#AppVersion}
AppCopyright={#AppCopyright}
AppPublisher={cm:AppPublisher}
AppPublisherURL={cm:AppPublisherURL}
AppReadmeFile={cm:AppReadmeFile}
AppUpdatesURL={cm:AppUpdatesURL}

DefaultDirName={autopf}\{#AppPublisher}\{#AppName}
DisableProgramGroupPage=yes
LicenseFile=..\..\LICENSE
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=..\..\dist
OutputBaseFilename={#OutputBaseFilename}
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern dynamic
ArchitecturesAllowed={#ArchitecturesAllowed}
ArchitecturesInstallIn64BitMode={#ArchitecturesInstallIn64BitMode}
AllowNoIcons=yes
UninstallDisplayIcon={app}\{#AppExeName}
VersionInfoOriginalFileName={#OutputBaseFilename}.exe
VersionInfoVersion={#VersionInfoVersion}
VersionInfoCompany={#AppPublisher}
ShowLanguageDialog=auto

[Languages]
Name: en_us; MessagesFile: "compiler:Default.isl"
Name: zh_cn; MessagesFile: "..\..\third-party\kira-96\Inno-Setup-Chinese-Simplified-Translation\ChineseSimplified.isl"

[CustomMessages]
AppName=VCF Generator Lite
AppDescription=Merge contacts into a vCard file
AppPublisher=Jesse205
AppPublisherURL=https://github.com/Jesse205
AppReadmeFile=https://github.com/hellotool/VCFGeneratorLiteWithTkinter/blob/master/README.md
AppUpdatesURL=https://github.com/hellotool/VCFGeneratorLiteWithTkinter/releases
OSNotSupportedMessage=The version of Windows you are currently using is too old, and this application cannot run on this system.%n%nWe provide compatibility solutions for older versions of Windows. Please refer to the following guide:%n%nhttps://gitee.com/hellotool/VCFGeneratorLiteWithTkinter/blob/master/docs/troubleshooting/runs-on-older-windows.md
UninstallFailed=Uninstall failed

zh_cn.AppName=VCF 生成器 轻量版
zh_cn.AppDescription=将联系人合并为 vCard 文件
zh_cn.AppPublisher=Jesse205
zh_cn.AppPublisherURL=https://gitee.com/Jesse205
zh_cn.AppReadmeFile=https://gitee.com/hellotool/VCFGeneratorLiteWithTkinter/blob/master/README.md
zh_cn.AppUpdatesURL=https://gitee.com/hellotool/VCFGeneratorLiteWithTkinter/releases

zh_cn.OSNotSupportedMessage=您当前使用的 Windows 版本过旧，本应用无法在此系统上运行。%n%n我们提供了针对旧版 Windows 的兼容运行方案，请参阅以下指南：%n%nhttps://gitee.com/hellotool/VCFGeneratorLiteWithTkinter/blob/master/docs/troubleshooting/runs-on-older-windows.md
zh_cn.UninstallFailed=自动卸载失败

[Code]

function GetUninstallString(): String;
var
  UninstallPath: String;
begin
  UninstallPath :=
    'Software\Microsoft\Windows\CurrentVersion\Uninstall\' +
    '{2CA151A5-049F-4AD9-92B1-5F0A244F52A4}_is1';
  if RegQueryStringValue(HKA, UninstallPath, 'UninstallString', Result) then
    Exit;

  Result := '';
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  UninstallCmd: String;
  ResultCode: Integer;
  ErrorMessage: String;
begin
  if (CurStep = ssInstall) then
  begin
    UninstallCmd := GetUninstallString();
    if UninstallCmd <> '' then
    begin
      UninstallCmd := RemoveQuotes(UninstallCmd);
      if FileExists(UninstallCmd) then
      begin
        if not Exec(UninstallCmd, '/SILENT /NORESTART /SUPPRESSMSGBOXES', '',
            SW_HIDE, ewWaitUntilTerminated, ResultCode) then
        begin
          ErrorMessage := CustomMessage('UninstallFailed') + #13#10 +
            SysErrorMessage(ResultCode) + ' (' + IntToStr(ResultCode) + ')';

          MsgBox(ErrorMessage, mbError, MB_OK);
        end;
      end;
    end;
  end;
end;

var
  OSNotSupportedMessageShown: Boolean;

procedure InitializeWizard();
begin
  OSNotSupportedMessageShown := False;
end;

procedure CurInstallProgressChanged(CurProgress, MaxProgress: Integer);
var
  WinVersion: TWindowsVersion;
begin
  GetWindowsVersionEx(WinVersion);
  if (CurProgress=MaxProgress) and (WinVersion.Major = 6) and (WinVersion.Minor = 1) and (not OSNotSupportedMessageShown) then
  begin
    MsgBox(CustomMessage('OSNotSupportedMessage'), mbInformation, MB_OK);
    OSNotSupportedMessageShown := True;
  end;
end;

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "..\..\dist\vcf_generator_lite\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{cm:AppName}"; Filename: "{app}\{#AppExeName}"; Comment: "{cm:AppDescription}"
Name: "{autodesktop}\{cm:AppName}"; Filename: "{app}\{#AppExeName}"; Tasks: desktopicon; Comment: "{cm:AppDescription}"

[Run]
Filename: "{app}\{#AppExeName}"; Description: "{cm:LaunchProgram,{cm:AppName}}"; Flags: nowait postinstall skipifsilent

